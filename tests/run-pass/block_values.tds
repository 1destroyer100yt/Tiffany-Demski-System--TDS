// A block's value is its last expression.
fn sign(n: Int) -> Int:
    if n > 0:
        1
    else if n < 0:
        -1
    else:
        0

fn classify(n: Int) -> String = match sign(n):
    1: "positive"
    -1: "negative"
    _: "zero"

fn clamp(x: Int, lo: Int, hi: Int) -> Int:
    if x < lo:
        return lo
    if x > hi:
        return hi
    x

fn main():
    print(sign(-9))
    print(classify(4))
    print(classify(0))
    print(clamp(15, 0, 10))
    print(clamp(5, 0, 10))
    let grade = if clamp(87, 0, 100) >= 90: "A" else if clamp(87, 0, 100) >= 80: "B" else: "C"
    print(grade)
