// Sorting written in TDS: insertion sort and quicksort, both in place
// through `mut` parameters. Exit test for Phase 1.

fn insertion_sort(xs: mut List[Int]):
    for i in 1..<len(xs):
        let key = xs[i]
        var j = i - 1
        while j >= 0 and xs[j] > key:
            xs[j + 1] = xs[j]
            j -= 1
        xs[j + 1] = key

fn swap(xs: mut List[Int], a: Int, b: Int):
    let t = xs[a]
    xs[a] = xs[b]
    xs[b] = t

fn partition(xs: mut List[Int], lo: Int, hi: Int) -> Int:
    let pivot = xs[hi]
    var i = lo
    for j in lo..<hi:
        if xs[j] < pivot:
            swap(mut xs, i, j)
            i += 1
    swap(mut xs, i, hi)
    return i

fn quicksort(xs: mut List[Int], lo: Int, hi: Int):
    if lo >= hi:
        return
    let p = partition(mut xs, lo, hi)
    quicksort(mut xs, lo, p - 1)
    quicksort(mut xs, p + 1, hi)

fn is_sorted(xs: List[Int]) -> Bool:
    for i in 1..<len(xs):
        if xs[i - 1] > xs[i]:
            return false
    return true

// A simple pseudo-random sequence so the test is repeatable.
fn random_list(n: Int, seed: Int) -> List[Int]:
    var out: List[Int] = []
    var state = seed
    for _i in 0..<n:
        state = (state * 1103515245 + 12345) % 2147483648
        out.push(state % 1000)
    return out

fn sort_words(words: mut List[String]):
    for i in 1..<len(words):
        var j = i
        while j > 0 and words[j - 1] > words[j]:
            let t = words[j]
            words[j] = words[j - 1]
            words[j - 1] = t
            j -= 1

fn main():
    var a = [5, 2, 9, 1, 5, 6, -3, 0]
    insertion_sort(mut a)
    print(a)

    var b = [38, 27, 43, 3, 9, 82, 10]
    quicksort(mut b, 0, len(b) - 1)
    print(b)

    var big = random_list(2000, 42)
    print("sorted before: {is_sorted(big)}")
    quicksort(mut big, 0, len(big) - 1)
    print("sorted after: {is_sorted(big)}, size {len(big)}")

    var empty: List[Int] = []
    quicksort(mut empty, 0, len(empty) - 1)
    print(empty)

    var words = ["pear", "apple", "fig", "banana"]
    sort_words(mut words)
    print(words)
